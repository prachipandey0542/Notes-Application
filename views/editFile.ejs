<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/editFile.css">
</head>
<body>
    <main>
        <div class="EditData">
            <a id="back" href="/">Go Back to Home</a> 
            <form action="/edit" method="post"> 
                <input id="pre" type="text" name="previous" value="<%= filename %>" required/>
                <input type="text" name="new" placeholder="Enter New Name" required/>
                <button type="submit" class="btn">Save Updates</button>
            </form>
           
        </div>
    </main>
</body>
</html>